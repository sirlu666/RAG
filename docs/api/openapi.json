    "/api/docs/{doc_id}/reindex": {
      "post": {
        "tags": [
          "document"
        ],
        "summary": "重建索引",
        "operationId": "reindex_document_api_docs__doc_id__reindex_post",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Doc Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
