    "/api/docs/{doc_id}/status": {
      "get": {
        "tags": [
          "document"
        ],
        "summary": "解析进度（前端 1.5s 轮询）",
        "operationId": "document_status_api_docs__doc_id__status_get",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
