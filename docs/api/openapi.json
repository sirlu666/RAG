                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/stream": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "SSE 流式问答",
        "operationId": "chat_stream_api_chat_stream_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 事件流：meta → citation* → delta* → done（异常补 error）",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: meta\ndata: {\"message_id\":\"m_1\",\"conversation_id\":\"c_1\",\"retrieval_ms\":212,\"hits\":5}\n\nevent: delta\ndata: {\"text\":\"由题意，\"}\n\n"
              }
            }
          },
          "403": {
            "description": "知识库/会话不属于当前用户（code=1003，JSON 信封）"
          },
          "404": {
            "description": "会话不存在（code=1004，JSON 信封）"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/image/recognize": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "图片题目识别（B-03）：图片 → 校对文本，供 C 校对后走 /api/chat/stream",
        "description": "临时题目图片识别，不写入知识库/向量索引，不修改用户资料。\n\n复用 A 的 recognize_question_image（OCR/公式处理），返回可校对文本；\n空/低质量文本不自动发起猜测回答，由 C 侧决定是否让用户补充。\n临时文件随请求生命周期释放，不落用户上传目录。",
        "operationId": "recognize_image_api_chat_image_recognize_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_recognize_image_api_chat_image_recognize_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "识别结果 {text, latex, warnings}，C 校对 text 后作为 question 发起问答",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "图片类型/大小/像素/内容非法（code=2001/2002/1001，JSON 信封）"
          },
          "403": {
            "description": "未登录或越权（JSON 信封）"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "健康检查",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_recognize_image_api_chat_image_recognize_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_recognize_image_api_chat_image_recognize_post"
      },
      "Body_upload_document_api_docs_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "pdf/docx/md/txt"
          },
          "kb_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kb Id"
          },
          "overwrite": {
            "type": "boolean",
            "title": "Overwrite",
            "description": "同库同名文件覆盖（版本更新）",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_docs_upload_post"
      },
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "kb_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Kb Ids"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "kb_ids",
          "question"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
