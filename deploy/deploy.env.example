# Copy to deploy/deploy.env; ignored by Git. Supply your own key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_THINKING=disabled
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=0
RERANK_CANDIDATE_LIMIT=16
RERANK_MAX_LENGTH=512
AUTH_COOKIE_SECURE=false
# For optional formula OCR after preparing its isolated environment and weights:
# OCR_FORMULA=rapid_latex
# FORMULA_PYTHON=/opt/formula/bin/python
# FORMULA_MODEL_DIR=/models/formula-onnx
