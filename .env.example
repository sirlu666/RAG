# ===== A 的配置（文档链路）。复制为根目录 .env 使用 =====

APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Embedding ---
# dev：本地哈希向量，零依赖，只用于验证链路（检索质量不能用于评估）
# api：OpenAI 兼容 /embeddings（bge-m3），上线与评估必须切到它并重建索引
EMBED_PROVIDER=dev
EMBED_MODEL=BAAI/bge-m3
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=
# dev 用 256；切 api + bge-m3 时改成 1024，然后重建索引
EMBED_DIM=256
EMBED_BATCH=32

# --- 向量库 ---
# auto：装了 chromadb 就用它，否则用本地文件实现（data/chroma/local_store.json）
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=math_chunks

# --- 存储 ---
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# --- 切分 ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- 扫描件 OCR ---
# OCR_ENABLE=true 时，PDF 无文字层会自动 OCR（CPU，约 3–5s/页 @200dpi）
OCR_ENABLE=true
OCR_ENGINE=rapid
OCR_DPI=200
# 0 = 不限页数；调试时可设 5，只处理前 5 页
OCR_MAX_PAGES=0
# 公式转 LaTeX：auto（有 pix2tex 或 API 就用）| none | pix2tex | api
OCR_FORMULA=auto
# 走商业接口时填（Mathpix 兼容）：准确率最高，按页计费
OCR_FORMULA_API_URL=
OCR_FORMULA_API_KEY=

# ===================== B：RAG 引擎 =====================
# --- 大模型（DeepSeek，OpenAI 兼容协议）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_FIRST_TOKEN_TIMEOUT_S=10
LLM_MAX_RETRIES=2
# 没配 key 时置 true：用模板回答跑通 SSE 链路（不可用于答辩/评估）
MOCK_LLM=false

# --- 检索 ---
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RRF_K=60
HYBRID_ENABLED=true
# 低于该相关度直接拒答（dev 哈希向量与 bge-m3 的分布不同，切 api 后需重新标定）
RELEVANCE_THRESHOLD=0.35
BM25_CACHE_TTL_S=60

# --- 多轮上下文 ---
HISTORY_TURNS=3
HISTORY_CHAR_BUDGET=1500

# --- Rerank（可选；留空即 no-op，按 RRF 顺序取 Top-N）---
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_S=15
