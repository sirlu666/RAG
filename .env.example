# ===== 复制为 .env 并把 key 填上，不要把真实 key 提交到仓库 =====

# --- 应用 ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 大模型（DeepSeek，OpenAI 兼容）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# --- Embedding ---
# provider: local | api   （local 用 sentence-transformers 加载 bge-m3，需自行下载模型）
EMBED_PROVIDER=api
EMBED_MODEL=BAAI/bge-m3
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBED_DIM=1024
EMBED_BATCH=32

# --- Rerank ---
RERANK_ENABLE=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5

# --- 检索 ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=math_chunks
RETRIEVE_VECTOR_K=20
RETRIEVE_BM25_K=20
RRF_K=60
CONFIDENCE_THRESHOLD=0.35

# --- 存储 ---
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# --- 切分（A 调参用）---
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- 开发辅助 ---
MOCK_LLM=0
LOG_LEVEL=INFO
