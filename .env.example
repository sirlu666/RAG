# ===== A 的配置（文档链路）。复制为根目录 .env 使用 =====

APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Embedding ---
# 推荐 local：本地 bge-m3（免费、断网可用），首次用 modelscope 下载权重（见 README 队友上手）
# dev：本地哈希向量，零依赖，只用于验证链路（检索质量不能用于评估/答辩）
# api：OpenAI 兼容 /embeddings（SiliconFlow bge-m3 / 智谱 embedding-3），按量付费
EMBED_PROVIDER=local
# local 模式：模型目录（相对项目根）或 HF 名称
EMBED_LOCAL_MODEL=data/models/bge-m3
# api 模式：模型名与接口
EMBED_MODEL=BAAI/bge-m3
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_DIM=1024
EMBED_BATCH=16
EMBED_MAX_CHARS=6000

# --- 向量库 ---
# chroma：真向量库（默认，需 pip install chromadb）
# auto：装了 chromadb 就用它，否则本地文件实现；local：强制 JSON 文件
VECTOR_BACKEND=chroma
CHROMA_DIR=./data/chroma
# collection 自动带模型后缀（如 math_chunks_bge-m3），换 embedding 模型不会互相污染
CHROMA_COLLECTION=math_chunks

# --- 模型下载（EMBED_PROVIDER=local 首次下载 4.3GB 用）---
# 方式一：modelscope（国内直连）
#   python -m pip install modelscope
#   python -c "from modelscope import snapshot_download; snapshot_download('BAAI/bge-m3', local_dir='data/models/bge-m3')"
# 方式二：HF 镜像
HF_ENDPOINT=https://hf-mirror.com

# --- 存储 ---
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# --- 切分 ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- 扫描件 OCR ---
# OCR_ENABLE=true 时，PDF 无文字层会自动 OCR（CPU，约 3–5s/页 @200dpi）
OCR_ENABLE=true
OCR_ENGINE=rapid
OCR_DPI=200
# 0 = 不限页数；调试时可设 5，只处理前 5 页
OCR_MAX_PAGES=0
# OCR 引擎：rapid（逐行文字，默认）| vlm（整页多模态转录，表格/行内公式更好）

# 公式转 LaTeX（仅 OCR_ENGINE=rapid 时有效）：auto | none | pix2tex | api
OCR_FORMULA=auto
# 走商业接口时填（Mathpix 兼容）：准确率最高，按页计费
OCR_FORMULA_API_URL=
OCR_FORMULA_API_KEY=

# --- 多模态整页转录（OCR_ENGINE=vlm 时必填，OpenAI 兼容接口）---
# 例：通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-vl-max
#     GLM-4V  https://open.bigmodel.cn/api/paas/v4 + glm-4v
VLM_API_BASE=
VLM_API_KEY=
VLM_MODEL=qwen-vl-max
VLM_TIMEOUT=120

# --- 自动打标（scripts/auto_label.py，独立凭据，不假定复用 VLM/DeepSeek）---
# 留空则回退 VLM_API_*；两者都空时脚本报「待真实调用」
LABEL_API_BASE=
LABEL_API_KEY=
LABEL_MODEL=glm-4-flash

# ===================== B：RAG 引擎 =====================
# --- 大模型（DeepSeek，OpenAI 兼容协议）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_THINKING=enabled
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=60
LLM_FIRST_TOKEN_TIMEOUT_S=10
LLM_MAX_RETRIES=2
# 没配 key 时置 true：用模板回答跑通 SSE 链路（不可用于答辩/评估）
MOCK_LLM=false

# --- 检索 ---
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RRF_K=60
HYBRID_ENABLED=true
# 低于该相关度直接拒答（dev 哈希向量与 bge-m3 的分布不同，切 api 后需重新标定）
# 低于该相关度直接拒答。0.62 是在 bge-m3 + 2519 真实 chunk 上用
# scripts/calibrate_threshold.py 实测的（域外问题 0.48–0.57，正样本 0.51–1.00）。
# 换 embedding 模型或大规模换语料后必须重跑该脚本再改。
# 注意：EMBED_PROVIDER=dev（哈希向量）的分布不同，dev 下 0.62 会大量误拒。
RELEVANCE_THRESHOLD=0.62
BM25_CACHE_TTL_S=60

# --- 多轮上下文 ---
HISTORY_TURNS=3
HISTORY_CHAR_BUDGET=1500

# --- Rerank（可选）---
# provider=local：本地 bge-reranker-v2-m3（默认，断网可用，需先下载模型到 RERANK_LOCAL_MODEL）
# provider=api：OpenAI 兼容 /rerank（SiliconFlow 等），需填 base/key
# provider=none：不重排，按 RRF 顺序取 Top-N
RERANK_PROVIDER=local
RERANK_LOCAL_MODEL=data/models/bge-reranker-v2-m3
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_S=15

# --- 相似问题与资料推荐（B-04）---
# related_materials 从检索候选取（零额外模型调用）；related_questions 仅可解释规则生成
RELATED_MAX=3
