# ===== A 的配置（文档链路）。复制为根目录 .env 使用 =====

APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Embedding ---
# dev：本地哈希向量，零依赖，只用于验证链路（检索质量不能用于评估）
# api：OpenAI 兼容 /embeddings（bge-m3），上线与评估必须切到它并重建索引
EMBED_PROVIDER=dev
EMBED_MODEL=BAAI/bge-m3
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=
# dev 用 256；切 api + bge-m3 时改成 1024，然后重建索引
EMBED_DIM=256
EMBED_BATCH=32

# --- 向量库 ---
# auto：装了 chromadb 就用它，否则用本地文件实现（data/chroma/local_store.json）
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=math_chunks

# --- 存储 ---
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# --- 切分 ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100
